# ===== SECRETOS DEL SERVIDOR =====
# Copia este archivo al servidor como .env  y cambia TODOS los valores.
# Este archivo NO se sube a GitHub (está en .gitignore).

# MySQL
MYSQL_ROOT_PASSWORD=cambia-esta-contrasena-root
MYSQL_USER=inventario_app
MYSQL_PASSWORD=cambia-esta-contrasena-app

# Backend / JWT (usa una clave larga, min 32 caracteres)
JWT_SECRET=cambia-por-una-frase-larga-y-aleatoria-de-al-menos-32-caracteres

# URL publica de la app (con dominio + https)
FRONTEND_URL=https://tu-dominio.com